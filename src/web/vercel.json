{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-GVaPEG+k3MaXcPb+brW1oSQsYthtjdO6bY9GACN1ees=' 'sha256-NEjifCx0vYfOfWFfLbuRcAYvLmtBIqZnVhbcKdeN7SA=' 'sha256-Ouu1scoJpxOeUGTJKkC/KnSlXJYDzWGhF8/AdRto4mo=' 'sha256-m0ZMKsN5TKKoJ2/vfMj8eFNrDZ+3GKcpnWNGcqHoD/k=' 'sha256-vCClR/McaW27cpASee2r7K9bgOWl82S/Hdm1tPCWW5I='; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; connect-src 'self' https: wss:; img-src 'self' https: data: blob:; media-src 'self' https: data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; frame-src https:; worker-src 'self' blob:; manifest-src 'self'"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/.well-known/webauthn",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/agents",
      "destination": "/agents.html"
    },
    {
      "source": "/pink",
      "destination": "/pink.html"
    },
    {
      "source": "/blue",
      "destination": "/blue.html"
    },
    {
      "source": "/yellow",
      "destination": "/yellow.html"
    },
    {
      "source": "/vexvoid",
      "destination": "/vexvoid.html"
    },
    {
      "source": "/npg",
      "destination": "/npg.html"
    },
    {
      "source": "/npgx",
      "destination": "/npgx.html"
    },
    {
      "source": "/white",
      "destination": "/white.html"
    },
    {
      "source": "/desktop",
      "destination": "/desktop.html"
    },
    {
      "source": "/((?!assets/|icons/|api/)[^.]*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/opns-mint",
      "destination": "/bmint/opns",
      "permanent": true
    },
    {
      "source": "/calls",
      "destination": "/bphone",
      "permanent": true
    },
    {
      "source": "/calls/:path*",
      "destination": "/bphone/:path*",
      "permanent": true
    },
    {
      "source": "/bPhone",
      "destination": "/bphone",
      "permanent": true
    },
    {
      "source": "/bPhone/:path*",
      "destination": "/bphone/:path*",
      "permanent": true
    },
    {
      "source": "/market",
      "destination": "/exchange",
      "permanent": true
    },
    {
      "source": "/market/:path*",
      "destination": "/exchange/:path*",
      "permanent": true
    },
    {
      "source": "/media",
      "destination": "/bmusic",
      "permanent": true
    },
    {
      "source": "/media/:path*",
      "destination": "/bmusic/:path*",
      "permanent": true
    },
    {
      "source": "/tickets",
      "destination": "/wallet/tickets",
      "permanent": true
    },
    {
      "source": "/tickets/:path*",
      "destination": "/wallet/tickets/:path*",
      "permanent": true
    },
    {
      "source": "/credits",
      "destination": "/wallet/credits",
      "permanent": true
    },
    {
      "source": "/credits/:path*",
      "destination": "/wallet/credits/:path*",
      "permanent": true
    },
    {
      "source": "/feed",
      "destination": "/bchatx-feed",
      "permanent": true
    },
    {
      "source": "/feed/:path*",
      "destination": "/bchatx-feed/:path*",
      "permanent": true
    },
    {
      "source": "/bmusic/artist/:slug",
      "destination": "/bmusic/artists/:slug",
      "permanent": true
    }
  ]
}
