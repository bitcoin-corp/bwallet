<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- App link: www.bwallet.space/pair (phone pairing QR) opens the app. Verified by site/.well-known/assetlinks.json. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www.bwallet.space" android:path="/pair" />
                <data android:scheme="https" android:host="www.bwallet.space" android:path="/social" />
            </intent-filter>
            <!-- Continue with X / Google returns here (site/social.html → bwalletx://social#…) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="bwalletx" android:host="social" />
            </intent-filter>
            <!-- Sign in with HandCash returns here with a sealed grant (bit-sign PKCE: src/mobile/social/handcashLogin.ts) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="bwalletx" android:host="auth" android:pathPrefix="/handcash" />
            </intent-filter>
            <!-- Space pages, invites and room pages: bwalletx://space/<slug>, bwalletx://invite/<code>,
                 bwalletx://room/<ticker> from the /s/, /i/ and /r/ pages (src/mobile/spaces/inviteLinks.ts). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="bwalletx" android:host="space" />
                <data android:scheme="bwalletx" android:host="invite" />
                <data android:scheme="bwalletx" android:host="room" />
                <data android:scheme="bwalletx" android:host="xinvite" />
                <!-- bwalletx://theme/<pack>: Install on bwalletx.com/themes (src/mobile/theme/themeLink.ts) -->
                <data android:scheme="bwalletx" android:host="theme" />
            </intent-filter>

        </activity>

        <!-- Live Spaces keep playing while you use other apps (SpaceSessionService.java,
             src/mobile/spaces/background.ts). Microphone type only while on stage. -->
        <service
            android:name=".SpaceSessionService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback|microphone" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Passkeys for rpId web.bwalletx.com (PasskeysPlugin.java). The site side is
             https://web.bwalletx.com/.well-known/assetlinks.json (get_login_creds for both app ids). -->
        <meta-data
            android:name="asset_statements"
            android:resource="@string/asset_statements" />

        <!-- Push (FCM): status-bar icon, tint and the "chat" channel the server targets (src/mobile/push). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_bwallet" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="chat" />
    </application>

    <!-- Permissions -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Live Spaces in the background (SpaceSessionService): Android 14 needs the per-type permissions. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Spaces keep going with the screen off: asked once (SpaceSessionPlugin.requestIgnoreBatteryOptimizations). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- bWallet calls: microphone for 1-to-1 voice; Capacitor's WebChromeClient requests it at runtime. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Video calls (src/mobile/calls) and scanning a website QR code to pair (src/mobile/pair). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Android 11+: lets SpeechRecognizer find the speech service (hold the dock's b to talk to b). -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
</manifest>
