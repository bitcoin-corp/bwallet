    {
      "source": "/agent",
      "destination": "https://bwalletx.com/agent",
      "permanent": false
    },
    {
      "source": "/strategies",
      "destination": "https://bwalletx.com/strategies",
      "permanent": false
    },
    {
      "source": "/adult",
      "destination": "https://bwalletx.com/adult",
      "permanent": false
    },
    {
      "source": "/exchange",
      "destination": "https://bwalletx.com/exchange",
      "permanent": false
    },
    {
      "source": "/cli",
      "destination": "https://bwalletx.com/cli",
      "permanent": false
    },
    {
      "source": "/mcp",
      "destination": "https://bwalletx.com/mcp",
      "permanent": false
    },
    {
      "source": "/mint",
      "destination": "https://bwalletx.com/mint",
      "permanent": false
    },
    {
      "source": "/buy",
      "destination": "https://bwalletx.com/buy",
      "permanent": false
    },
    {
      "source": "/download",
      "destination": "https://bwalletx.com/get",
      "permanent": false
    }
  ]
}
