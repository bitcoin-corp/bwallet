{
  "rewrites": [
    {
      "source": "/b-Aware",
      "destination": "/b-aware.html"
    },
    {
      "source": "/b-aware",
      "destination": "/b-aware.html"
    },
    {
      "source": "/bugs",
      "destination": "/b-aware.html"
    },
    {
      "source": "/disclosure",
      "destination": "/b-aware.html"
    },
    {
      "source": "/security",
      "destination": "/b-aware.html"
    },
    {
      "source": "/bounty",
      "destination": "/b-aware.html"
    },
    {
      "source": "/api/theme-orders/:op",
      "destination": "/api/theme-orders?op=:op"
    },
    {
      "source": "/api/theme-sites",
      "destination": "/api/themes?list=sites"
    },
    {
      "source": "/api/shops/:op",
      "destination": "/api/shops?op=:op"
    },
    {
      "source": "/authorize",
      "destination": "/api/auth?op=authorize",
      "has": [
        {
          "type": "host",
          "value": "auth.bwalletx.com"
        }
      ]
    },
    {
      "source": "/token",
      "destination": "/api/auth?op=token",
      "has": [
        {
          "type": "host",
          "value": "auth.bwalletx.com"
        }
      ]
    },
    {
      "source": "/userinfo",
      "destination": "/api/auth?op=userinfo",
      "has": [
        {
          "type": "host",
          "value": "auth.bwalletx.com"
        }
      ]
    },
    {
      "source": "/wallet",
      "destination": "/api/auth?op=wallet",
      "has": [
        {
          "type": "host",
          "value": "auth.bwalletx.com"
        }
      ]
    },
    {
      "source": "/.well-known/openid-configuration",
      "destination": "/api/auth?op=discovery",
      "has": [
        {
          "type": "host",
          "value": "auth.bwalletx.com"
        }
      ]
    },
    {
      "source": "/.well-known/jwks.json",
      "destination": "/api/auth?op=jwks",
      "has": [
        {
          "type": "host",
          "value": "auth.bwalletx.com"
        }
      ]
    },
    {
      "source": "/api/auth/:op",
      "destination": "/api/auth?op=:op",
      "has": [
        {
          "type": "host",
          "value": "auth.bwalletx.com"
        }
      ]
    },
    {
      "source": "/pair",
      "destination": "/pair.html"
    },
    {
      "source": "/browse",
      "destination": "/browse.html"
    },
    {
      "source": "/social",
      "destination": "/social.html"
    },
    {
      "source": "/api/social/:provider/callback",
      "destination": "/api/social?op=:provider"
    },
    {
      "source": "/api/social/:op",
      "destination": "/api/social?op=:op"
    },
    {
      "source": "/.well-known/bsvalias",
      "destination": "/api/paymail?op=caps"
    },
    {
      "source": "/api/paymail/:op/:handle/:pubkey",
      "destination": "/api/paymail?op=:op&handle=:handle&pubkey=:pubkey"
    },
    {
      "source": "/api/paymail/:op/:handle",
      "destination": "/api/paymail?op=:op&handle=:handle"
    },
    {
      "source": "/api/paymail/:op",
      "destination": "/api/paymail?op=:op"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/.well-known/security.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/download/:file*",
      "destination": "https://bwalletx.com/download/:file*",
      "permanent": false
    },
    {
      "source": "/features",
      "destination": "https://bwalletx.com/features",
      "permanent": false
    },
    {
      "source": "/friends",
      "destination": "https://bwalletx.com/friends",
      "permanent": false
    },
    {
      "source": "/android",
      "destination": "https://bwalletx.com/android",
      "permanent": false
    },
    {
      "source": "/extension",
      "destination": "https://bwalletx.com/extension",
      "permanent": false
    },
    {
      "source": "/developers",
      "destination": "https://bwalletx.com/developers",
      "permanent": false
    },
    {
      "source": "/connect.js",
      "destination": "https://bwalletx.com/connect.js",
      "permanent": false
    },
    {
      "source": "/get",
      "destination": "https://bwalletx.com/get",
      "permanent": false
