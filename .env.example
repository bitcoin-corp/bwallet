# X API keys for the bWalletX account (developer.x.com → your app → Keys and tokens).
# The app's "User authentication settings" must be Read and write BEFORE you generate the access token.
# Copy this file to .env.local (gitignored) and fill it in there. Never commit real values.
X_API_KEY=your-key-here
X_API_SECRET=your-key-here
X_ACCESS_TOKEN=your-key-here
X_ACCESS_SECRET=your-key-here

# bChat poster keys (official bWalletX account). Live ONLY in ~/Secrets/bwalletx-poster/poster.env and the server .env.local.
BCHAT_ROOT_WIF=
BCHAT_SIGN_WIF=

# Nightly blog (blog.mjs). Server-only file .env.blog (gitignored, chmod 600). Never commit real values.
# ANTHROPIC_API_KEY=            same key as the push server
# BWALLETX_AGENT_SECRET=        same secret as bit-sign and the push server (x-b-signature)
# BITSIGN_URL=https://www.bitcoinchat.online
# GITHUB_TOKEN_B0ASE=           fine-grained, owner b0ase: contents read on bit-sign, read+write on bwalletx-site
# GITHUB_TOKEN_BCORP=           fine-grained, owner bitcoin-corp: contents read on bwallet, bwalletx-push, bwalletx-indexer, bagents
# BLOG_MODEL=claude-opus-5-5
