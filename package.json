  "scripts": {
    "dev": "vite",
    "build": "tsx scripts/build.ts",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test src site/test relay/e2e && node --test relay/relay.node-test.mjs",
    "verify:build": "tsx scripts/verify-build.ts",
    "package": "tsx scripts/package.ts",
    "release": "tsx scripts/release.ts",
    "debug:ext": "tsx scripts/debug-extension.ts",
    "build:mobile": "vite build -c vite.config.mobile.ts && vite build -c vite.config.dapp.ts",
    "build:mobile:store": "VITE_STORE_BUILD=1 pnpm build:mobile",
    "build:web": "vite build -c vite.config.web.ts",
    "build:desktop": "VITE_WIDE_WEB=1 VITE_CHANNEL=desktop vite build -c vite.config.desktop.ts",
    "desktop:dev": "pnpm build:desktop && tauri dev",
    "desktop:build": "bash scripts/channel-build.sh desktop-mac",
    "tauri": "tauri",
    "preview:web": "vite preview -c vite.config.web.ts --port 4781 --strictPort",
    "test:overflow": "bun scripts/overflow-audit.ts",
    "preview:mobile": "vite preview -c vite.config.mobile.ts --port 4780 --strictPort",
    "test:mobile-smoke": "tsx scripts/mobile-smoke.ts",
    "cap:sync": "pnpm build:mobile && cap sync",
    "cap:sync:store": "pnpm build:mobile:store && cap sync",
    "ios": "pnpm cap:sync && cap open ios",
    "ios:store": "pnpm cap:sync:store && cap open ios",
    "android": "pnpm cap:sync && cap open android",
    "android:store": "pnpm cap:sync:store && cap open android",
    "release:ios-store": "bash scripts/channel-build.sh ios-store",
    "release:ios-private": "bash scripts/channel-build.sh ios-private",
    "release:android-play": "bash scripts/channel-build.sh android-play",
    "release:android-direct": "bash scripts/channel-build.sh android-direct",
    "pin:upstream": "tsx scripts/pin-from-bun-lock.ts && pnpm install",
    "add-app": "node scripts/add-app.mjs",
    "lint": "eslint src"
  },
