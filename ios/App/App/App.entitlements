<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push (src/mobile/push). Xcode writes "production" into exported App Store / Ad Hoc builds. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal links: www.bwallet.space/pair (phone pairing QR) opens the app. See site/.well-known. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:www.bwallet.space</string>
		<!-- Room X invites: www.bchatx.com/i/x/* (bchatx.com/.well-known/apple-app-site-association). -->
		<string>applinks:www.bchatx.com</string>
		<!-- Passwords: iOS offers and saves a strong wallet password (iCloud Keychain). -->
		<string>webcredentials:www.bwallet.space</string>
		<!-- Passkeys (src/mobile/passkey/nativePasskeys.ts): rpId web.bwalletx.com, never the whole bwalletx.com. -->
		<string>webcredentials:web.bwalletx.com</string>
	</array>
</dict>
</plist>
